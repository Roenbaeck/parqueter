{
	"name": "parqueter",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"features": {
		"ghcr.io/devcontainers/features/powershell:1": {},
		// Optional: an SSH server, so that `gh codespace ssh` can run commands in the codespace from outside it.
		"ghcr.io/devcontainers/features/sshd:1": {
			"version": "latest"
		}
	},
	"postCreateCommand": "pwsh -NoProfile -Command \"Install-Module PSParquet -Scope CurrentUser -Force\"",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csharp",
				"ms-vscode.powershell"
			],
			"settings": {
				"[csharp]": {
					"editor.formatOnSave": true
				},
				"terminal.integrated.defaultProfile.linux": "pwsh"
			}
		}
	},
	"remoteUser": "vscode"
}
